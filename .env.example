# Copy to .env.local, fill in real values, then restart npm run dev.
# Never commit .env.local. Empty integrations remain unavailable.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Discord Developer Portal > OAuth2. Both values must belong to the same app.
# Register http://localhost:3000/api/auth/callback/discord as an OAuth2 redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: separate OAuth application (takes precedence over the values above).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Bot tab token, not the OAuth client secret or public key.
DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_BEARER_TOKEN=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
